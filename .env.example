# LlmAvatarAssistant demo environment (copy to .env.local and fill in).
# .env.local is git-ignored — never commit real keys.

# Where the /v1 dev proxy forwards requests (your llama.cpp router)
VITE_LLM_PROXY_TARGET=http://127.0.0.1:8080

# API key for the router. The Vite dev proxy injects it into proxied
# requests server-side, so the browser never sees it.
VITE_LLM_PROXY_KEY=your-key-here

# Model id the demo uses by default (any id served by the router)
VITE_LLM_MODEL=your-model-id
